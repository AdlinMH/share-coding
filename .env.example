# Copy to .env.local. All variables are SERVER ONLY.
# May use the existing TanyaAja! Supabase project and the same GROUP_ID.
GROUP_ID=share-coding
# Choose your own 4-digit PIN, including leading zeros if desired.
OWNER_PIN=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Enable only for a disposable test database, never production.
SHARE_CODING_TEST_DB=0
